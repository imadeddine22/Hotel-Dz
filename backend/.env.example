# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/dzhotels
# For MongoDB Atlas use: mongodb+srv://<user>:<password>@<cluster>/dzhotels

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Cloudinary (hotel/room images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chargily Pay (DZD payments)
CHARGILY_API_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test

# Email (Nodemailer — booking confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DzHotels <no-reply@dzhotels.dz>"

# URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
